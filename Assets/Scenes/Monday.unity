      m_Calls: []
  m_text: "Hello! It's the owner of Cubert Daycare. Sorry I couldn't be there on
    your first day, I've got some other business to deal with at the moment. \n\nIn
    the meantime I can give you some quick instructions on how to begin working here.\n\nPut
    Cuberts in their room when they come, complete their needs, and give Cuberts
    back to their owner if they are here to pick them up.\n\nGood luck!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
